  "narrative": {
    "northStar": "燭光下的手抄本",
    "overview": "整站是一本被翻開的老書：進站是深棕皮革的暗室，一本燙金書封等你點開；翻進去之後，是羊皮紙色的閱讀頁，經文行距寬鬆。金色只用在細線、頁碼與點綴，從不用作大面積填色。",
    "keyCharacteristics": [
      "深棕皮革與羊皮紙兩種亮度，共用一組棕金色票",
      "全站單一字體 Noto Serif TC，細字重 300 為主",
      "金色細線與菱形作為分隔飾紋",
      "經文行距 2.3，並有淡淡的橫格背景線",
      "入口有 3D 開書儀式動畫與星點背景（待重構）"
    ],
    "rules": [
      { "name": "The Candle Rule", "body": "金色是光，不是顏料：只畫在線、點、字上，不鋪面。", "section": "colors" },
      { "name": "The Three Tags Rule", "body": "人名、地名、概念各一個色，介面其他元素不得借用這三個色來裝飾。", "section": "colors" },
      { "name": "The Whisper Weight Rule", "body": "正文維持 300 細字重，只有標題與選中態升到 500。", "section": "typography" },
      { "name": "The Flat Page Rule", "body": "紙頁上不使用柔和模糊陰影，疊層只用淡金硬陰影。", "section": "elevation" }
    ],
    "dos": [
      "Do 在暗底使用 gold (#D4A847)，在紙頁使用 gold-soft (#C9A96E)，兩者不互換。",
      "Do 保持正文 300 字重、行距 2.3，經文區留白。",
      "Do 用人名鏽紅、地名森綠、概念靛紫標註，並保持點狀底線樣式一致。",
      "Do 把分隔做成「漸隱金線 + 菱形」。"
    ],
    "donts": [
      "Don't 在介面其他地方使用鏽紅、森林綠、靛紫來裝飾。",
      "Don't 在紙頁上使用大面積實心金色或柔和模糊陰影。",
